    <worksheet name='Karte Bestellungen'>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_orders (burgermetrics.fact_orders)+ (postgres)' name='federated.17leplc137yzr40zj8xie12ky8v7' />
            <datasource caption='Parameter' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Jahr' datatype='integer' default-format='n0;-0' name='[Parameter 5100132363096068]' param-domain-type='list' role='measure' type='quantitative' value='2025'>
              <calculation class='tableau' formula='2025' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.17leplc137yzr40zj8xie12ky8v7'>
            <column caption='Bestellungen Jahr' datatype='integer' name='[Calculation_5100132363784199]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF YEAR([date]) = [Parameters].[Parameter 5100132363096068] THEN [order_id] END)' />
            </column>
            <column caption='Bestellungen VJ' datatype='integer' name='[Calculation_5100132363821064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF YEAR([date]) = [Parameters].[Parameter 5100132363096068] - 1 THEN [order_id] END)' />
            </column>
            <column caption='Δ Bestellungen %' datatype='real' name='[Calculation_5100132364222478]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_5100132363784199] - [Calculation_5100132363821064]) / [Calculation_5100132363821064]' />
            </column>
            <column caption='Δ Bestellungen Text' datatype='string' name='[Calculation_5100132365881368]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_5100132363821064]) THEN &quot;kein Vorjahr im Bestand&quot; ELSE IF [Calculation_5100132364222478] &gt;= 0 THEN &quot;+&quot; ELSE &quot;&quot; END + REPLACE(STR(ROUND([Calculation_5100132364222478] * 100, 1)), &quot;.&quot;, &quot;,&quot;) + &quot; % zum Vorjahr&quot; END' />
            </column>
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Order Id' datatype='integer' name='[order_id]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_5100132363784199]' derivation='User' name='[usr:Calculation_5100132363784199:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_5100132365881368]' derivation='User' name='[usr:Calculation_5100132365881368:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
