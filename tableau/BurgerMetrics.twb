              <calculation class='tableau' formula='{ FIXED : MAX(IF { FIXED [branch_name] : SUM(IF YEAR([date]) = [Parameters].[Parameter 5100132363096068] THEN [net_total] END) } = { FIXED : MAX({ FIXED [branch_name] : SUM(IF YEAR([date]) = [Parameters].[Parameter 5100132363096068] THEN [net_total] END) }) } THEN [branch_name] END) }' />
            </column>
