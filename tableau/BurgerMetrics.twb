      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_orders (burgermetrics.fact_orders)+ (postgres)' name='federated.17leplc137yzr40zj8xie12ky8v7' />
            <datasource caption='Parameter' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Jahr' datatype='integer' default-format='n0;-0' name='[Parameter 5100132363096068]' param-domain-type='list' role='measure' type='quantitative' value='2025'>
              <calculation class='tableau' formula='2025' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.17leplc137yzr40zj8xie12ky8v7'>
            <column caption='Umsatz Jahr' datatype='real' name='[Calculation_5100132363702277]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([date]) = [Parameters].[Parameter 5100132363096068] THEN [net_total] END)' />
            </column>
            <column caption='Umsatz Tsd Jahr' datatype='real' name='[Calculation_5100132365291538]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5100132363702277] / 1000' />
            </column>
            <column caption='Umsatz Tsd letzter Monat' datatype='real' name='[Calculation_5100132365418516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH(MIN([date])) = MONTH(MAX({ FIXED : MAX(IF YEAR([date]) = [Parameters].[Parameter 5100132363096068] THEN [date] END) })) THEN [Calculation_5100132365291538] END' />
            </column>
            <column caption='Zeile' datatype='integer' name='[Calculation_5100132492132381]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT((INDEX() - 1) / 4)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Im Jahr' datatype='boolean' name='[Calculation_5100132492333086]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR([date]) = [Parameters].[Parameter 5100132363096068]' />
            </column>
            <column caption='Branch Name' datatype='string' name='[branch_name]' role='dimension' type='nominal' />
