table fact_orders
	lineageTag: 15867c2d-d1a9-4375-8020-8070f0d2de03

	measure Umsatz = SUM(fact_orders[net_total])
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 79851052-2547-4741-ba14-b05c3d22e656

	measure Bestellungen = COUNTROWS(fact_orders)
		formatString: #,0
		lineageTag: 80dbac7b-4880-4135-a672-ef5a1c5fe6ed

	measure Bestellwert = DIVIDE([Umsatz], [Bestellungen])
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: b096b24e-d976-4a28-9365-b5b0b3436b43

	measure 'Umsatz 2025' = CALCULATE([Umsatz], dim_date[year] = 2025)
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: c0539244-c1d8-4b88-a358-035e7abe6c0d

	measure 'Umsatz VJ' = IF(HASONEVALUE(dim_date[year]), CALCULATE([Umsatz], SAMEPERIODLASTYEAR(dim_date[date])))
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		displayFolder: Dashboard
		lineageTag: da807629-6be0-4170-a272-5ea36f41222f

	measure 'Δ Umsatz' = [Umsatz] - [Umsatz VJ]
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		displayFolder: Dashboard
		lineageTag: e5e3e1f0-ba8d-474e-9d93-e013d2095da5

	measure 'Δ Umsatz %' = DIVIDE([Δ Umsatz], [Umsatz VJ])
		formatString: +0.0\ %;-0.0\ %;0.0\ %
		displayFolder: Dashboard
		lineageTag: 1124075c-4d10-4a27-ad5e-ab3cb080f70d

	measure 'Bestellungen VJ' = IF(HASONEVALUE(dim_date[year]), CALCULATE([Bestellungen], SAMEPERIODLASTYEAR(dim_date[date])))
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: fd14c997-2239-425b-ac21-a9783debd452

	measure 'Δ Bestellungen %' = DIVIDE([Bestellungen] - [Bestellungen VJ], [Bestellungen VJ])
		formatString: +0.0\ %;-0.0\ %;0.0\ %
		displayFolder: Dashboard
		lineageTag: 185aed5c-17a5-4393-8c5e-ee04e6266e32

	measure 'Bestellwert VJ' = DIVIDE([Umsatz VJ], [Bestellungen VJ])
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		displayFolder: Dashboard
		lineageTag: 74371191-f8b7-4ceb-abf3-3c6c8cd326bd

	measure 'Δ Bestellwert %' = DIVIDE([Bestellwert] - [Bestellwert VJ], [Bestellwert VJ])
		formatString: +0.0\ %;-0.0\ %;0.0\ %
		displayFolder: Dashboard
		lineageTag: a773d56a-baa6-4050-be50-4c2afdb58aa2

	measure 'Umsatz Tsd' = DIVIDE([Umsatz], 1000)
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 42956cc6-e52c-4f0c-a83f-e1bbe09c48c1

	measure 'Umsatz VJ Tsd' = DIVIDE([Umsatz VJ], 1000)
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 95723daf-0ddc-4bb8-9faa-9951c478a6c3

	measure 'Δ Umsatz Farbe' = IF([Δ Umsatz] >= 0, "#2E7D32", "#A32638")
		displayFolder: Dashboard
		lineageTag: fe9e0049-66d2-442e-acc2-05924785fa10

	measure 'Δ Bestellungen Farbe' = IF([Bestellungen] >= [Bestellungen VJ], "#2E7D32", "#A32638")
		displayFolder: Dashboard
		lineageTag: b70ba4d3-de19-481c-a454-7d43d4d4ceba

	measure 'Δ Bestellwert Farbe' = IF([Bestellwert] >= [Bestellwert VJ], "#2E7D32", "#A32638")
		displayFolder: Dashboard
		lineageTag: ee6f7c4d-3e08-45b2-969a-b34be7f86a69

	measure 'Δ Umsatz Text' = IF(NOT HASONEVALUE(dim_date[year]), "ein Jahr wählen für den Vorjahresvergleich", IF(ISBLANK([Umsatz VJ]), "kein Vorjahr im Bestand", FORMAT([Δ Umsatz %], "+0.0 %;-0.0 %;0.0 %") & " zum Vorjahr"))
		displayFolder: Dashboard
		lineageTag: 906eb4a0-53d2-4aa0-a294-00c62c5a3a27

	measure 'Δ Bestellungen Text' = IF(NOT HASONEVALUE(dim_date[year]), "ein Jahr wählen für den Vorjahresvergleich", IF(ISBLANK([Bestellungen VJ]), "kein Vorjahr im Bestand", FORMAT([Δ Bestellungen %], "+0.0 %;-0.0 %;0.0 %") & " zum Vorjahr"))
		displayFolder: Dashboard
		lineageTag: 0b585136-2e32-4a22-b4cb-a11bfd832ab9

	measure 'Δ Bestellwert Text' = IF(NOT HASONEVALUE(dim_date[year]), "ein Jahr wählen für den Vorjahresvergleich", IF(ISBLANK([Bestellwert VJ]), "kein Vorjahr im Bestand", FORMAT([Δ Bestellwert %], "+0.0 %;-0.0 %;0.0 %") & " zum Vorjahr"))
		displayFolder: Dashboard
		lineageTag: d9ce44f6-f891-4547-9e10-b834b6b3b2d6

	measure 'Top Filiale' = MAXX(TOPN(1, VALUES(dim_branch[branch_name]), [Umsatz], DESC), dim_branch[branch_name])
		displayFolder: Dashboard
		lineageTag: 5a2ad00d-5293-405c-be98-3b7d8dca72b5

	measure 'Titel Dashboard' = "Umsatz " & IF(HASONEVALUE(dim_date[year]), SELECTEDVALUE(dim_date[year]), MIN(dim_date[year]) & "–" & MAX(dim_date[year])) & ": " & FORMAT(DIVIDE([Umsatz], 1000000), "0.00") & " Mio. €" & IF(ISBLANK([Umsatz VJ]), "", ", " & FORMAT([Δ Umsatz %], "+0.0 %;-0.0 %;0.0 %") & " zum Vorjahr") & " – " & [Top Filiale] & " liegt vorn"
		displayFolder: Dashboard
		lineageTag: 72a71c68-4819-4c3e-a759-2a7db0119209

	measure 'Umsatz Tsd letzter Monat' =
			VAR letzter = CALCULATE(MAX(fact_orders[date]), ALLSELECTED(dim_date))
			RETURN IF(SELECTEDVALUE(dim_date[month]) = MONTH(letzter), [Umsatz Tsd])
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: a33e286a-e6f9-4bae-95ab-cc4f6b7354c3

