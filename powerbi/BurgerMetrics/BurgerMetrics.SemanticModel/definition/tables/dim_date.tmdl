	column Monat = SWITCH(dim_date[month], 1, "Jan", 2, "Feb", 3, "Mär", 4, "Apr", 5, "Mai", 6, "Jun", 7, "Jul", 8, "Aug", 9, "Sep", 10, "Okt", 11, "Nov", 12, "Dez")
		lineageTag: a76bef0e-1856-4b5b-b767-15a53969ebb7
		summarizeBy: none
		sortByColumn: month

		annotation SummarizationSetBy = Automatic

	column Monatsstufe = IF(MOD(dim_date[month] - 1, 3) = 0 || dim_date[month] = 12, dim_date[Monat], REPT(UNICHAR(8203), dim_date[month]))
		lineageTag: 497c3893-0d45-49c6-b90f-163601ab5620
		summarizeBy: none
		sortByColumn: month

		annotation SummarizationSetBy = Automatic

