# Verbindung zur selbstgehosteten Supabase (VPS). Werte niemals committen.
PGHOST=supabase.butscher.cloud
PGPORT=5433
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=***
# Alle Python-Betreiberverbindungen erzwingen sslmode=verify-full.
# CA des DB-/Pooler-Zertifikats, ueber einen vertrauenswuerdigen Weg beziehen.
PGSSLROOTCERT=/absoluter/pfad/zur/datenbank-ca.pem
# Direkte MCP-Leseanmeldung, unabhaengig vom Betreiberkonto oben.
# Voraussetzung: 0020_demo_rolle.sql + betrieb/studi_daba_lesend.sql.
BM_MCP_READ_USER=studi_daba
BM_MCP_READ_PASSWORD=thws
SUPABASE_URL=https://supabase.butscher.cloud
SUPABASE_ANON_KEY=***
